dm:A00174 a dm:Claim ;
    rdfs:label "호날두의 진술: 유럽·브라질·호주·미국·포르투갈 구단의 제안을 받았지만 알나스르와의 약속을 지켰다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "입단 기자회견에서 유럽, 브라질, 호주, 미국, 포르투갈의 여러 구단이 자신을 영입하려 했지만 알나스르에 약속했다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
