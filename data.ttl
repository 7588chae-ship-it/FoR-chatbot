@prefix dm:     <https://example.org/dm#> .
@prefix for:    <https://example.org/for#> .
@prefix schema: <https://schema.org/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .

# FoR 데이터셋 (크리스티아누 호날두 · 맨체스터 유나이티드 · 알나스르)
# 원본: FoR-Instance, FoR-triple, shcema 시트

<https://example.org/dataset/FoR> a owl:Ontology ;
    rdfs:label "FoR 데이터셋"@ko .

dm:groupName a owl:DatatypeProperty ; rdfs:label "세부 분류(GroupName)"@ko .
dm:dataset   a owl:DatatypeProperty ; rdfs:label "데이터셋"@ko .


# ===== 클래스 =====

dm:Person a owl:Class ;
    rdfs:label "인물"@ko, "Person"@en ;
    rdfs:comment "등장인물: 작품 속 인물 (label 규칙: 이름) / 실존 인물: 실제로 존재하거나 존재했던 사람 (label 규칙: 이름)"@ko .

dm:Organization a owl:Class ;
    rdfs:label "단체"@ko, "Organization"@en ;
    rdfs:comment "작중 단체: 작품 속 가문·조직·기관 (label 규칙: 이름) / 실재 단체: 실제 기관·구단·매체·회사 (label 규칙: 이름)"@ko .

dm:Place a owl:Class ;
    rdfs:label "장소"@ko, "Place"@en ;
    rdfs:comment "작중 장소: 작품 속 세계·장소 (label 규칙: 이름) / 실재 장소: 실제 도시·국가·건물 (label 규칙: 이름)"@ko .

dm:Event a owl:Class ;
    rdfs:label "사건"@ko, "Event"@en ;
    rdfs:comment "사건: 작품 속에서 한 번 일어난 일. 약속·판결·전투도 포함 (label 규칙: [누구]의 [무엇]) / 실재 사건: 실제로 한 번 일어난 일. 수상·채택·인터뷰·입단도 포함 (label 규칙: [누구]의 [무엇])"@ko .

dm:Object a owl:Class ;
    rdfs:label "사물"@ko, "Object"@en ;
    rdfs:comment "사물: 작품 속에서 하나뿐인 물건 (label 규칙: 무엇인지 알 수 있는 이름)"@ko .

dm:Work a owl:Class ;
    rdfs:label "작품"@ko, "Work"@en ;
    rdfs:comment "작품: 데이터의 소재가 되는 작품 전체 (label 규칙: 작품명)"@ko .

dm:Episode a owl:Class ;
    rdfs:label "회차"@ko, "Episode"@en ;
    rdfs:comment "회차: 작품의 화·권 (label 규칙: [작품명] [권] [화])"@ko .

dm:Scene a owl:Class ;
    rdfs:label "장면"@ko, "Scene"@en ;
    rdfs:comment "장면: 회차 안의 장면. 근거 위치의 단위 (label 규칙: [데이터셋]_E[회차]_S[장면])"@ko .

dm:Utterance a owl:Class ;
    rdfs:label "대사"@ko, "Utterance"@en ;
    rdfs:comment "대사: 인물이 한 특정한 말 (label 규칙: [누구]의 대사: 핵심 말)"@ko .

dm:Document a owl:Class ;
    rdfs:label "자료"@ko, "Document"@en ;
    rdfs:comment "자료: 기사·결의안·청문회 기록 등 근거 문서 (label 규칙: [매체·기관]의 [무엇] 기사·문서)"@ko .

dm:Concept a owl:Class ;
    rdfs:label "개념"@ko, "Concept"@en ;
    rdfs:comment "형식: 작품의 매체 형식 (label 규칙: 용어) / 장르: 작품의 장르 (label 규칙: 용어) / 세계관 용어: 작품 세계 안에서만 쓰이는 용어 (label 규칙: 용어) / 법·제도: 실제 법·제도·계약 개념 (label 규칙: 용어) / 언어학 용어: 언어학 개념·용어 (label 규칙: 용어)"@ko .

dm:Claim a owl:Class ;
    rdfs:label "주장"@ko, "Claim"@en ;
    rdfs:comment "주장: 누군가의 의심·진술·보도·해석. 사실로 확인되지 않은 것 (label 규칙: [주장자]의 진술·의심·보도: 문장)"@ko .

dm:Dilemma a owl:Class ;
    rdfs:label "딜레마"@ko, "Dilemma"@en ;
    rdfs:comment "딜레마: 둘 다 지킬 이유가 있지만 둘 다 가질 수 없는 선택의 국면 (label 규칙: [주체]: ~할 것인가)"@ko .

dm:Option a owl:Class ;
    rdfs:label "선택지"@ko, "Option"@en ;
    rdfs:comment "선택지: 딜레마에서 고를 수 있었던 길. 실제로 일어나지 않은 길도 포함 (label 규칙: ~한다)"@ko .

# ===== 관계(속성) =====

dm:hasDecisionMaker a owl:ObjectProperty ;
    rdfs:label "고르는 사람"@ko ;
    rdfs:comment "딜레마에서 선택해야 하는 사람"@ko ;
    schema:domainIncludes dm:Dilemma ;
    schema:rangeIncludes dm:Person .

dm:hasOption a owl:ObjectProperty ;
    rdfs:label "선택지"@ko ;
    rdfs:comment "선택지마다 한 행씩. 고르지 않은 선택지도 잇는다"@ko ;
    schema:domainIncludes dm:Dilemma ;
    schema:rangeIncludes dm:Option .

dm:actualChooser a owl:ObjectProperty ;
    rdfs:label "실제로 고른 사람"@ko ;
    rdfs:comment "실제로 고른 선택지에만 쓴다. 사람이 아니라 선택지가 source"@ko ;
    schema:domainIncludes dm:Option ;
    schema:rangeIncludes dm:Person .

dm:isRealizedBy a owl:ObjectProperty ;
    rdfs:label "실현된 사건"@ko ;
    rdfs:comment "선택지가 실제 사건으로 이루어졌을 때"@ko ;
    schema:domainIncludes dm:Option ;
    schema:rangeIncludes dm:Event .

dm:isOutcomeOf a owl:ObjectProperty ;
    rdfs:label "딜레마의 결과"@ko ;
    rdfs:comment "딜레마에서 실제로 일어난 결과. target은 선택지가 아니라 딜레마"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Dilemma .

dm:isReasonFor a owl:ObjectProperty ;
    rdfs:label "선택 이유"@ko ;
    rdfs:comment "그 선택지를 고르게 된 이유. 해석이면 remark에 작업자 해석: 표시"@ko ;
    schema:domainIncludes dm:Claim, dm:Event ;
    schema:rangeIncludes dm:Option .

dm:hasParticipant a owl:ObjectProperty ;
    rdfs:label "참여자"@ko ;
    rdfs:comment "사건에 참여한 사람·단체마다 한 행씩"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Person, dm:Organization .

dm:precedes a owl:ObjectProperty ;
    rdfs:label "앞선 사건"@ko ;
    rdfs:comment "앞서 일어난 사건이 source. 순서만 나타낸다"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Event .

dm:hasCause a owl:ObjectProperty ;
    rdfs:label "원인"@ko ;
    rdfs:comment "작품·기록에서 원인이 확인된 경우에만 쓴다"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Event .

dm:revealedIn a owl:ObjectProperty ;
    rdfs:label "공개 위치"@ko ;
    rdfs:comment "작중 시점과 독자에게 공개되는 위치가 다를 때"@ko ;
    schema:domainIncludes dm:Event, dm:Claim ;
    schema:rangeIncludes dm:Episode, dm:Scene, dm:Document .

dm:hasClaimant a owl:ObjectProperty ;
    rdfs:label "주장자"@ko ;
    rdfs:comment "주장에는 반드시 주장자를 잇는다"@ko ;
    schema:domainIncludes dm:Claim ;
    schema:rangeIncludes dm:Person, dm:Organization .

dm:isAbout a owl:ObjectProperty ;
    rdfs:label "대상"@ko ;
    rdfs:comment "주장·자료가 무엇에 관한 것인지"@ko ;
    schema:domainIncludes dm:Claim, dm:Document .

dm:isEvidenceFor a owl:ObjectProperty ;
    rdfs:label "근거"@ko ;
    rdfs:comment "주장이나 딜레마를 뒷받침하는 사건·대사·자료"@ko ;
    schema:domainIncludes dm:Event, dm:Utterance, dm:Document ;
    schema:rangeIncludes dm:Claim, dm:Dilemma .

dm:leadsTo a owl:ObjectProperty ;
    rdfs:label "이어지는 주장"@ko ;
    rdfs:comment "한 주장이 다른 주장으로 이어질 때"@ko ;
    schema:domainIncludes dm:Claim ;
    schema:rangeIncludes dm:Claim .

dm:reports a owl:ObjectProperty ;
    rdfs:label "보도한 사건"@ko ;
    rdfs:comment "기사가 보도한 사건. 발언일은 사건에, 보도일은 기사에 적는다"@ko ;
    schema:domainIncludes dm:Document ;
    schema:rangeIncludes dm:Event .

dm:mentions a owl:ObjectProperty ;
    rdfs:label "언급한 대상"@ko ;
    rdfs:comment "인터뷰·기사·대사에서 언급한 대상"@ko ;
    schema:domainIncludes dm:Event, dm:Document, dm:Utterance .

dm:nextScene a owl:ObjectProperty ;
    rdfs:label "다음 장면"@ko ;
    rdfs:comment "장면의 순서"@ko ;
    schema:domainIncludes dm:Scene ;
    schema:rangeIncludes dm:Scene .

dm:depicts a owl:ObjectProperty ;
    rdfs:label "그려진 사건"@ko ;
    rdfs:comment "회차·장면에 그려진 사건"@ko ;
    schema:domainIncludes dm:Episode, dm:Scene ;
    schema:rangeIncludes dm:Event, dm:Claim .

dm:receivedAward a owl:ObjectProperty ;
    rdfs:label "받은 상"@ko ;
    rdfs:comment "수상 사건과 잇는다. 수상일은 수상 사건 remark에"@ko ;
    schema:domainIncludes dm:Person, dm:Work ;
    schema:rangeIncludes dm:Event .

for:manages a owl:ObjectProperty ;
    rdfs:label "감독을 맡은 구단"@ko ;
    rdfs:comment "감독이 source"@ko ;
    schema:domainIncludes dm:Person ;
    schema:rangeIncludes dm:Organization .

for:closesOption a owl:ObjectProperty ;
    rdfs:label "닫힌 선택지"@ko ;
    rdfs:comment "사건 때문에 더 이상 고를 수 없게 된 선택지"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Option .

for:basedOn a owl:ObjectProperty ;
    rdfs:label "근거 제도"@ko ;
    rdfs:comment "사건이 근거로 삼은 실제 법·제도·계약 방식"@ko ;
    schema:domainIncludes dm:Event ;
    schema:rangeIncludes dm:Concept .

# ===== 인스턴스 =====

dm:A00033 a dm:Concept ;
    rdfs:label "상호 합의 계약 해지"@ko ;
    dm:groupName "법·제도"@ko ;
    rdfs:comment "계약 당사자 양쪽이 합의해 계약 기간이 끝나기 전에 계약을 끝내는 방식이다. 2022년 11월 호날두와 맨체스터 유나이티드의 계약 해지가 이 방식으로 이루어졌다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00034 a dm:Concept ;
    rdfs:label "자유계약"@ko ;
    dm:groupName "법·제도"@ko ;
    rdfs:comment "계약이 끝나거나 해지되어 소속 구단이 없는 선수가 이적료 없이 다른 구단과 계약하는 것이다. 호날두는 맨체스터 유나이티드와 계약을 해지한 뒤 자유계약 신분으로 알나스르에 입단했다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00181 a dm:Person ;
    rdfs:label "피어스 모건"@ko ;
    dm:groupName "실존 인물"@ko ;
    rdfs:comment "1965년 출생, 영국의 텔레비전 진행자 및 언론인이다. 2022년 11월 호날두를 인터뷰했다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00035 a dm:Person ;
    rdfs:label "크리스티아누 호날두"@ko ;
    dm:groupName "실존 인물"@ko ;
    rdfs:comment "1985년 2월 5일 포르투갈 마데이라섬 푼샬에서 태어난 축구 선수다. 스포르팅 CP에서 프로 생활을 시작해 맨체스터 유나이티드(2003~2009), 레알 마드리드(2009~2018), 유벤투스(2018~2021)에서 뛰었다. 2021년 8월 맨체스터 유나이티드에 복귀했고, 2022년 11월 계약 해지 뒤 2022년 12월 30일 알나스르에 입단했다. 포르투갈 국가대표팀 주장이며 발롱도르를 5회 받았다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00036 a dm:Person ;
    rdfs:label "에릭 텐 하흐"@ko ;
    dm:groupName "실존 인물"@ko ;
    rdfs:comment "1970년 출생, 네덜란드 출신 축구 감독이다. 2022년 5월 맨체스터 유나이티드 감독으로 부임해 2024년 10월 경질되었다. 2022-23 시즌 호날두와 갈등을 빚었다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00037 a dm:Person ;
    rdfs:label "메이슨 그린우드"@ko ;
    dm:groupName "실존 인물"@ko ;
    rdfs:comment "2001년 출생, 2022년 당시 맨체스터 유나이티드 소속 선수다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00038 a dm:Person ;
    rdfs:label "해리 매과이어"@ko ;
    dm:groupName "실존 인물"@ko ;
    rdfs:comment "1993년 출생, 2022-23 시즌 맨체스터 유나이티드의 주장이었다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00039 a dm:Organization ;
    rdfs:label "맨체스터 유나이티드"@ko ;
    dm:groupName "실재 단체"@ko ;
    rdfs:comment "잉글랜드 맨체스터를 연고로 한 프로축구 구단이다. 잉글랜드 프리미어리그에 속한다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00040 a dm:Organization ;
    rdfs:label "알나스르"@ko ;
    dm:groupName "실재 단체"@ko ;
    rdfs:comment "사우디아라비아 리야드를 연고로 한 프로축구 구단으로, 사우디 프로리그에 속한다. 2022년 12월 30일 호날두가 입단했다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00041 a dm:Place ;
    rdfs:label "영국"@ko ;
    dm:groupName "실재 장소"@ko ;
    rdfs:comment "맨체스터 유나이티드의 연고지 맨체스터가 있는 나라다. 맨체스터 유나이티드는 잉글랜드 프리미어리그에 속한다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00042 a dm:Place ;
    rdfs:label "사우디아라비아"@ko ;
    dm:groupName "실재 장소"@ko ;
    rdfs:comment "알나스르의 연고지 리야드가 있는 나라다. 알나스르는 사우디 프로리그에 속한다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00043 a dm:Event ;
    rdfs:label "호날두와 맨체스터 유나이티드의 계약 해지"@ko ;
    dm:groupName "실재 사건"@ko ;
    rdfs:comment "2022년 11월 22일 호날두와 맨체스터 유나이티드가 상호 합의로 계약을 끝냈다. 피어스 모건 인터뷰가 처음 공개된 지 9일 뒤였다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00044 a dm:Event ;
    rdfs:label "호날두의 알나스르 입단"@ko ;
    dm:groupName "실재 사건"@ko ;
    rdfs:comment "2022년 12월 30일 알나스르가 호날두 영입을 발표했다. 계약 기간은 2025년 여름까지 약 2년 6개월이다. 이후 2025년 6월 2027년까지 재계약했다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-10-13"^^xsd:date .

dm:A00045 a dm:Event ;
    rdfs:label "호날두의 피어스 모건 인터뷰"@ko ;
    dm:groupName "실재 사건"@ko ;
