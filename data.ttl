    rdfs:comment "호날두가 2009년 인터뷰에서 축구하는 것을 사랑하며 축구가 자기 인생이라고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00164 a dm:Claim ;
    rdfs:label "호날두의 진술: 트로피를 최대한 많이 모아 마라도나·펠레처럼 역사의 첫 페이지에 오르고 싶다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "같은 인터뷰에서 팀과 개인 트로피를 최대한 많이 모으는 것이 야망이고, 마라도나·펠레처럼 역사의 첫 페이지에 남고 싶다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00165 a dm:Document ;
    rdfs:label "피어스 모건 언센서드의 호날두 인터뷰 영상"@ko ;
    dm:groupName "자료"@ko ;
    rdfs:comment "피어스 모건 언센서드 유튜브 채널에 올라온 2022년 11월 호날두 인터뷰 영상이다."@ko ;
    schema:url <https://www.youtube.com/watch?v=Jk9uJRMvBIA> ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00166 a dm:Claim ;
    rdfs:label "호날두의 진술: 텐 하흐가 나를 존중하지 않으니 나도 그를 존중하지 않는다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "피어스 모건 인터뷰에서 텐 하흐 감독에 대해, 그가 자신을 존중하지 않기 때문에 자신도 그를 존중하지 않는다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00167 a dm:Claim ;
    rdfs:label "호날두의 진술: 감독과 구단 고위층이 나를 내보내려 해 배신감을 느꼈다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "피어스 모건 인터뷰에서 감독뿐 아니라 구단 고위층 두세 명이 자신을 내보내려 했고, 이번 시즌뿐 아니라 지난 시즌에도 자신을 원하지 않는 사람들이 있다고 느껴 배신감을 느꼈다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00168 a dm:Claim ;
    rdfs:label "호날두의 진술: 퍼거슨 감독이 떠난 뒤 구단에 발전이 없었다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "피어스 모건 인터뷰에서 알렉스 퍼거슨 감독이 떠난 뒤 구단에 아무런 발전이 없었다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00169 a dm:Claim ;
    rdfs:label "호날두의 진술: 나는 구단이 잘되기를 바라고 구단을 사랑한다"@ko ;
    dm:groupName "주장"@ko ;
    rdfs:comment "피어스 모건 인터뷰에서 구단이 잘되기를 바라서 맨체스터 유나이티드로 돌아왔고 구단을 사랑한다고 말했다. 본인 발언이다."@ko ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00170 a dm:Claim ;
