dm:A00158 a dm:Event ;
    rdfs:label "호날두의 UEFA 챔피언스리그 역대 최다 득점자 특별상 수상"@ko ;
    dm:groupName "실재 사건"@ko ;
    rdfs:comment "2024년 8월 29일 모나코에서 열린 2024-25 챔피언스리그 조 추첨식에서 UEFA가 호날두에게 역대 최다 득점자 특별상을 주었다. 호날두의 챔피언스리그 통산 기록은 183경기 140골로 역대 1위다(2위 메시 129골). 득점왕 7회, 한 시즌 최다 17골(2013-14)도 역대 최고 기록이다. 140골은 호날두가 유럽을 떠난 2022년에 이미 확정된 기록이다."@ko ;
    schema:url <https://www.uefa.com/uefachampionsleague/news/0290-1bba8222dbee-c67bbff473ca-1000--cristiano-ronaldo-honoured-as-uefa-champions-league-all-/> ;
    dm:dataset "FoR" ;
    dct:creator "승민"@ko, "정훈"@ko, "민규"@ko ;
    dct:created "2026-11-12"^^xsd:date .

dm:A00159 a dm:Organization ;
    rdfs:label "UEFA"@ko ;
    dm:groupName "실재 단체"@ko ;
    rdfs:comment "유럽축구연맹으로, UEFA 챔피언스리그를 주최하는 단체다."@ko ;
    schema:url <https://www.uefa.com> ;
    dm:dataset "FoR" ;
